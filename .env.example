# Copia este archivo a ".env" y ajusta los valores que necesites.
# Todas las claves son opcionales: si faltan, se usan los valores por defecto.

# ── Ollama (IA local) ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60

# ── IA web (Selenium) ─────────────────────────────────────────────
# Motor por defecto cuando no especificas en la instrucción: gemini | chatgpt
MOTOR_IA_DEFECTO=gemini

# Timeouts en segundos
TIMEOUT_ESPERA_CAJA=60
TIMEOUT_RESPUESTA=180
# Tiempo de gracia para iniciar sesión manualmente en Chrome
TIMEOUT_LOGIN_MANUAL=180

# Ruta del perfil dedicado de Chrome para el bot.
# Por defecto: %LOCALAPPDATA%\VaderBrain\ChromeBotProfile (Windows)
# CHROME_PROFILE_PATH=C:\ruta\personalizada\ChromeBotProfile
